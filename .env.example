# === SSO (Google Workspace) 설정 예시 ===
# 1) AUTH_SECRET: `openssl rand -base64 33` 로 생성
AUTH_SECRET=replace-with-random-secret

# 2) Google Cloud Console에서 OAuth 클라이언트 발급 후 입력
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# 3) 로그인을 허용할 회사 이메일 도메인 (쉼표로 여러 개)
ALLOWED_EMAIL_DOMAINS=teamblind.com
